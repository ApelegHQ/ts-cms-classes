{
	"name": "@apeleghq/cms-classes",
	"version": "1.0.5",
	"description": "A collection of utility classes to encode ASN.1 data following DER rules",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./cms": {
			"import": {
				"types": "./dist/cms.d.ts",
				"default": "./dist/cms.mjs"
			},
			"require": {
				"types": "./dist/cms.d.cts",
				"default": "./dist/cms.cjs"
			}
		},
		"./pkcs10": {
			"import": {
				"types": "./dist/pkcs10.d.ts",
				"default": "./dist/pkcs10.mjs"
			},
			"require": {
				"types": "./dist/cms.d.cts",
				"default": "./dist/cms.cjs"
			}
		},
		"./x501": {
			"import": {
				"types": "./dist/x501.d.ts",
				"default": "./dist/x501.mjs"
			},
			"require": {
				"types": "./dist/x501.d.cts",
				"default": "./dist/x501.cjs"
			}
		},
		"./x509": {
			"import": {
				"types": "./dist/x509.d.ts",
				"default": "./dist/x509.mjs"
			},
			"require": {
				"types": "./dist/x509.d.cts",
				"default": "./dist/x509.cjs"
			}
		}
	},
	"devDependencies": {
		"@apeleghq/crypto-oids": "^20250325.0.0",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.23.0",
		"@types/node": "^22.13.11",
		"@typescript-eslint/eslint-plugin": "^8.27.0",
		"@typescript-eslint/parser": "^8.27.0",
		"esbuild": "^0.25.1",
		"eslint": "^9.23.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-prettier": "^5.2.3",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ApelegHQ/ts-cms-classes.git"
	},
	"files": [
		"dist/**/*"
	],
	"scripts": {
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"build": "tsc --emitDeclarationOnly --declarationMap --declaration && node --import ./loader.mjs esbuild.ts",
		"test": "node --import ./loader.mjs test/index.test.ts",
		"prepack": "npm run build",
		"prepublishOnly": "npm test && npm run lint",
		"preversion": "npm run lint",
		"version": "npm run lint && git add -A src",
		"postversion": "git push && git push --tags"
	},
	"author": "Apeleg Limited",
	"license": "ISC",
	"keywords": [
		"asn1",
		"asn.1",
		"der",
		"cms",
		"pkcs10",
		"pkcs#10",
		"x501",
		"x.501",
		"x509",
		"x.509"
	],
	"dependencies": {
		"@apeleghq/asn1-der": "^1.0.3"
	}
}
